NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server only. Required for account administration, login throttling and seeding.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
APP_ORIGIN=http://localhost:3000
# Local seeding only. Use at least 12 characters and rotate before production.
SEED_DEFAULT_PASSWORD=replace-with-a-strong-temporary-password
